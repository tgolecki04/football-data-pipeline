# Copy to .env and fill in your own values. Never commit real keys.

# API-Football - 1st source (https://dashboard.api-football.com/)
API_FOOTBALL_KEY=123456123456

# football-data.org - 2nd source (https://www.football-data.org/)
FOOTBALL_DATA_API_KEY=123456123456

# RustFS
RUSTFS_ACCESS_KEY=key
RUSTFS_SECRET_KEY=password
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=football-data

## PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_DB=db

# League and season to fetch data for (Default: Premier League 2023/24)
LEAGUE_ID=39
SEASON=2023